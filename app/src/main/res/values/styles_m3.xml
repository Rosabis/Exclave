<?xml version="1.0" encoding="utf-8"?>
<!-- Material Design 3 Styles -->
<resources>

    <!-- Tab Text Appearance M3 -->
    <style name="TabTextAppearance.M3" parent="TextAppearance.Design.Tab">
        <item name="textAllCaps">false</item>
    </style>

    <!-- M3 Card Styles -->
    <style name="Widget.M3.CardView.Elevated" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">1dp</item>
    </style>

    <style name="Widget.M3.CardView.Filled" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">12dp</item>
    </style>

    <style name="Widget.M3.CardView.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">12dp</item>
    </style>

    <!-- M3 Button Styles -->
    <style name="Widget.M3.Button.ElevatedButton" parent="Widget.Material3.Button.ElevatedButton">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Widget.M3.Button.FilledButton" parent="Widget.Material3.Button">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Widget.M3.Button.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Widget.M3.Button.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Widget.M3.Button.TonalButton" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerSize">20dp</item>
    </style>

    <!-- M3 FAB Styles -->
    <style name="Widget.M3.FloatingActionButton.Primary" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="fabSize">normal</item>
    </style>

    <style name="Widget.M3.FloatingActionButton.Secondary" parent="Widget.Material3.FloatingActionButton.Secondary">
        <item name="fabSize">normal</item>
    </style>

    <style name="Widget.M3.FloatingActionButton.Surface" parent="Widget.Material3.FloatingActionButton.Surface">
        <item name="fabSize">normal</item>
    </style>

    <!-- M3 Extended FAB Styles -->
    <style name="Widget.M3.ExtendedFloatingActionButton.Primary" parent="Widget.Material3.ExtendedFloatingActionButton.Primary">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Widget.M3.ExtendedFloatingActionButton.Secondary" parent="Widget.Material3.ExtendedFloatingActionButton.Secondary">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Widget.M3.ExtendedFloatingActionButton.Surface" parent="Widget.Material3.ExtendedFloatingActionButton.Surface">
        <item name="cornerSize">16dp</item>
    </style>

    <!-- M3 Chip Styles -->
    <style name="Widget.M3.Chip.Input" parent="Widget.Material3.Chip.Input">
        <item name="chipCornerRadius">8dp</item>
    </style>

    <style name="Widget.M3.Chip.Suggestion" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipCornerRadius">8dp</item>
    </style>

    <style name="Widget.M3.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">8dp</item>
        <item name="chipBackgroundColor">@color/m3_chip_background</item>
        <item name="android:textColor">@color/m3_chip_text_color</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <!-- M3 Input Styles -->
    <style name="Widget.M3.TextInputLayout.FilledBox" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="cornerSize">4dp</item>
    </style>

    <style name="Widget.M3.TextInputLayout.OutlinedBox" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="cornerSize">4dp</item>
    </style>

    <!-- M3 Switch Styles -->
    <style name="Widget.M3.Switch" parent="Widget.Material3.CompoundButton.Switch">
        <item name="trackTint">@color/m3_switch_track_tint</item>
        <item name="thumbTint">@color/m3_switch_thumb_tint</item>
    </style>

    <!-- M3 Slider Style -->
    <style name="Widget.M3.Slider" parent="Widget.Material3.Slider">
        <item name="haloRadius">24dp</item>
        <item name="thumbRadius">10dp</item>
    </style>

    <!-- M3 BottomAppBar Style -->
    <style name="Widget.M3.BottomAppBar" parent="Widget.Material3.BottomAppBar">
        <item name="backgroundTint">?colorSurface</item>
    </style>

    <!-- M3 NavigationDrawer Style -->
    <style name="Widget.M3.NavigationView" parent="Widget.Material3.NavigationView">
        <item name="itemShapeAppearance">@style/ShapeAppearance.M3.NavigationItem</item>
    </style>

    <style name="ShapeAppearance.M3.NavigationItem" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!-- M3 AppBar Style -->
    <style name="Widget.M3.AppBarLayout" parent="Widget.Material3.AppBarLayout">
        <item name="android:background">?android:colorBackground</item>
    </style>

    <!-- M3 Toolbar Style -->
    <style name="Widget.M3.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">?colorOnSurface</item>
        <item name="subtitleTextColor">?colorOnSurfaceVariant</item>
    </style>

    <!-- M3 Dialog Styles -->
    <style name="ThemeOverlay.M3.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="dialogCornerRadius">28dp</item>
    </style>

    <!-- M3 BottomSheet Style -->
    <style name="Widget.M3.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.M3.LargeComponent</item>
    </style>

    <!-- M3 Snackbar Style -->
    <style name="Widget.M3.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="actionTextColorAlpha">1.0</item>
    </style>

    <style name="Widget.M3.Snackbar.TextView" parent="Widget.Material3.Snackbar.TextView">
        <item name="android:maxLines">10</item>
    </style>

    <!-- M3 Divider Style -->
    <style name="Widget.M3.Divider" parent="Widget.Material3.MaterialDivider">
        <item name="dividerColor">?colorOutlineVariant</item>
    </style>

</resources>
